{
  "name": "uav_flight_sim",
  "version": "0.2.1",
  "description": "无人机飞行仿真纯算法层（零专有依赖，可在 CI / 离线仿真 / OpenHarmony 三方复用）",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx sim/sim_flight.ts",
    "selfcheck": "tsx tests/run-self-tests.ts",
    "check:dco": "node scripts/check-dco.mjs",
    "verify": "tsc -p tsconfig.json --noEmit && vitest run && tsx sim/sim_flight.ts && npm run check:dco"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "uav",
    "drone",
    "flight-simulation",
    "openharmony",
    "steering-behavior",
    "collision-avoidance",
    "spatial-perception"
  ],
  "author": "陈鹏至 (Derek0769) <447936551@qq.com>"
}
